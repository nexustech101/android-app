     Same geometry as store/make_icon.py. Everything sits inside the 66-unit adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Chimney -->
    <path android:fillColor="#FFFFFF" android:strokeColor="#FFFFFF"
        android:strokeWidth="3" android:strokeLineJoin="round"
        android:pathData="M65,32 H71 V46 H65 Z" />
    <!-- House with the lens opening cut out -->
    <path android:fillColor="#FFFFFF" android:strokeColor="#FFFFFF" android:fillType="evenOdd"
        android:strokeWidth="4" android:strokeLineJoin="round"
        android:pathData="M54,28 L74,49 L74,76 L34,76 L34,49 Z
            M41.5,59 a12.5,12.5 0 1,0 25,0 a12.5,12.5 0 1,0 -25,0 Z" />
